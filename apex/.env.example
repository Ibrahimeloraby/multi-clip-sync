# ── Anthropic ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── IBKR (TWS / IB Gateway) ─────────────────────────────────────────
# Dubai (DIFC) live gateway: port 4002 | paper: 4001
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1

# ── Social / News APIs ──────────────────────────────────────────────
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=APEX.AI/1.0
NEWS_API_KEY=

# ── Trading universe ────────────────────────────────────────────────
# Comma-separated list of ticker symbols
SYMBOLS=AAPL,TSLA,NVDA,MSFT,AMZN,GOOGL

# Account currency (AED for IBKR Dubai)
ACCOUNT_CURRENCY=AED

# ── Risk parameters ─────────────────────────────────────────────────
MAX_POSITION_SIZE_PCT=0.05   # 5% of portfolio per symbol
MAX_DAILY_LOSS_PCT=0.02      # halt trading after 2% daily drawdown
MAX_DRAWDOWN_PCT=0.10        # hard stop at 10% portfolio drawdown
MIN_SENTIMENT_CONFIDENCE=0.6 # ignore signals below this Claude confidence

# ── Agent loop ──────────────────────────────────────────────────────
LOOP_INTERVAL_SECONDS=60

# ── WebSocket (dashboard feed) ──────────────────────────────────────
WS_HOST=0.0.0.0
WS_PORT=8765
