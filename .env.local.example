# Browser Automation Credentials
# Copy this file to .env.local and fill in your credentials
# .env.local is git-ignored for security

# Supabase credentials (for running migrations)
SUPABASE_EMAIL=your-email@example.com
SUPABASE_PASSWORD=your-supabase-password

# Lovable credentials (for deployment automation)
LOVABLE_EMAIL=your-email@example.com
LOVABLE_PASSWORD=your-lovable-password

# Or use generic credentials for both services
# AUTOMATION_EMAIL=your-email@example.com
# AUTOMATION_PASSWORD=your-password
