# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...your-anon-key

# Service role key — ONLY for Railway workers and edge functions, NEVER in frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key-workers-only

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Firebase Cloud Messaging (push notifications) ──────────────────────────────
FCM_SERVER_KEY=AAAA...
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_PROJECT_ID=loyaltyone-prod
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ── Mapbox (geofencing + maps) ────────────────────────────────────────────────
VITE_MAPBOX_TOKEN=pk.eyJ1IjoibG95YWx0eW9uZSIs...

# ── PostHog analytics (optional) ─────────────────────────────────────────────
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://app.posthog.com

# ── Email (admin digest worker) ───────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_...
ADMIN_EMAIL=admin@loyaltyone.ae
FROM_EMAIL=notifications@loyaltyone.ae

# ── Postmark inbound (email-inbound worker) ───────────────────────────────────
POSTMARK_WEBHOOK_TOKEN=your-webhook-token

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_URL=https://loyaltyone.ae
VITE_APP_ENV=production
PORT=3000
